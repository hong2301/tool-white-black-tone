{
  "manifest_version": 3,
  "name": "白黑调色 · Dark Mode",
  "short_name": "白黑调色",
  "version": "1.0.0",
  "description": "识别页面的白色系元素与黑色系文字，按色阶自动映射成对应的深色 / 浅色，一键开关并记住每个网站的状态。",
  "minimum_chrome_version": "96",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "白黑调色",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "src/color.js",
        "src/engine.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "key": ""
}
